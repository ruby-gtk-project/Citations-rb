<?xml version="1.0" encoding="utf-8"?>
<!--
  Ported from upstream's data/org.gnome.World.Citations.gschema.xml.in: the
  same eight keys, the same defaults, the same seven <summary> strings
  (upstream repeats "Default template for book citation" on both the book and
  the article template key — that duplication is upstream's, kept as-is
  rather than silently "fixed" in the port).

  lib/settings.rb is what actually backs these eight keys at runtime, through
  a small JSON file rather than a compiled GSettings schema (see its class
  comment for why). This file exists so the schema's translatable strings
  have a home and a POTFILES.in entry, even though nothing here is compiled
  or installed.
-->
<schemalist>
  <schema path="/org/rubygtkproject/Citations/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>800</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="recent-files" type="as">
      <default>[]</default>
      <summary>List of paths of recent files</summary>
    </key>
    <key name="custom-book-template" type="s">
      <default>"%AUTHOR%, *%TITLE%*, %PUBLISHER%, %CITY%, %YEAR%."</default>
      <summary>Default template for book citation</summary>
    </key>
    <key name="custom-article-template" type="s">
      <default>"%AUTHOR%, *%TITLE%*, %JOURNAL% **%VOLUME%** (%YEAR%), no. %NUMBER%, %PAGES%."</default>
      <summary>Default template for book citation</summary>
    </key>
    <key name="template-kind" type="u">
      <default>0</default>
      <summary>Default template kind for citations</summary>
    </key>
    <key name="format-kind" type="u">
      <default>0</default>
      <summary>Default template format for citations</summary>
    </key>
  </schema>
</schemalist>
